# The build context is only the source the three stages copy. Everything here is either
# rebuilt inside the image, secret to a developer's machine, or a manuscript that must not be
# baked into a layer.

# Python build and cache artefacts
.venv/
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# The client is rebuilt in the web stage from source; a stale local build must not win.
web/node_modules/
web/dist/

# Version control and CI plumbing
.git/
.github/

# Project stores hold real, possibly unpublished, work. Never copy one into an image.
*.sqlite
*.sqlite-*

# Editor and OS noise
.vscode/
.idea/
.DS_Store

# Docs and scratch that no stage needs
DECISIONS.md
AI/
